# Laravel Cloud: application root app/, PHP 8.5, Node 24.
# Build command: sh cloud-build.sh
# Deploy command: php artisan migrate --force --no-interaction
# Health check: /up
APP_NAME=Fluxo
APP_ENV=staging
APP_DEBUG=false
# Set APP_URL to the HTTPS address assigned to staging.
# Keep Cloud's generated APP_KEY stable across deployments.
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Attach a PostgreSQL database in the application's region.
# Cloud injects DB_* / DB_URL. Do not override them with local SQLite values.
DB_SSLMODE=require
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database

# Attach a PRIVATE bucket and mark it as the default filesystem disk.
# Cloud injects its disk configuration. Do not set FILESYSTEM_DISK=local.
# For a separately managed Cloudflare R2 bucket, set these in Cloud's secrets:
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=...
# AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Configure a transactional email provider before enabling password recovery.
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtps
# MAIL_HOST=...
# MAIL_PORT=465
# MAIL_USERNAME=...
# MAIL_PASSWORD=...
# MAIL_FROM_ADDRESS=...
MAIL_FROM_NAME="${APP_NAME}"

# Stripe: one recurring price, USD 5.00 per month. Use test keys for staging.
BILLING_ENABLED=false
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Monthly Price with USD 5.00 as default and BRL 12.99 as a manual currency option.
STRIPE_PRO_PRICE_ID=
CASHIER_CURRENCY=usd
CASHIER_CURRENCY_LOCALE=en_US
ADS_ENABLED=false
