{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fluxo Jornada",
  "version": "0.1.0",
  "identifier": "com.fluxo.jornada",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": [
        "local-widget"
      ],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/128x128.png"
    ],
    "resources": {
      "../.build/resources/": ""
    },
    "shortDescription": "Seu widget de jornada, direto no computador.",
    "category": "Productivity",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
